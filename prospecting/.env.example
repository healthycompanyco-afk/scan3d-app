# Copia para prospecting/.env e preenche.
# SUPABASE_URL e SUPABASE_SERVICE_KEY são lidos de backend/.env — não repetir aqui.

# O teu id de utilizador no Snap3D. Descobre-o com:
#   python snap3d_prospect.py quem-sou --email o-teu@email.pt
SNAP3D_USER_ID=

# Endpoint do job de geração no Modal.
# Copia o valor da variável MODAL_TRELLIS_URL no painel do Render.
MODAL_TRELLIS_URL=
